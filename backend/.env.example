# Application
APP_NAME=MemoGraph
APP_VERSION=0.1.0
ENVIRONMENT=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=memograph
POSTGRES_USER=memograph
POSTGRES_PASSWORD=memograph

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Memgraph
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_URL=redis://localhost:6379/1
